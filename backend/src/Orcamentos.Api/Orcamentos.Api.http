# Requisições de teste da API.
# No VS Code, instale a extensão "REST Client" e clique em "Send Request" acima de cada requisição.
# A API precisa estar rodando: dotnet run --project src/Orcamentos.Api

@baseUrl = http://localhost:5080

### Verifica se a API está no ar (não exige login)
GET {{baseUrl}}/api/health
Accept: application/json

### Login: pergunta e-mail e senha na hora (nada fica salvo neste arquivo)
# @name login
# @prompt email Seu e-mail de login
# @prompt senha Sua senha
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "senha": "{{senha}}"
}

### Dados do usuário logado: usa o token da resposta do login acima (rode o login antes)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{login.response.body.token}}

### Sem token: deve responder 401
GET {{baseUrl}}/api/auth/me

# ===== Catálogo (rode o login antes) =====

### Cria uma categoria
# @name categoria
POST {{baseUrl}}/api/categorias
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nome": "Lavagem e higienização"
}

### Lista as categorias
GET {{baseUrl}}/api/categorias
Authorization: Bearer {{login.response.body.token}}

### Cria um serviço na categoria criada acima
# @name servico
POST {{baseUrl}}/api/servicos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "categoriaId": "{{categoria.response.body.id}}",
  "nome": "Lavagem Detalhada / Premium",
  "precoMinimo": 120,
  "precoMaximo": 180,
  "tempoEstimadoMin": 120
}

### Faixa inválida: deve responder 400 com a mensagem da regra
POST {{baseUrl}}/api/servicos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "categoriaId": "{{categoria.response.body.id}}",
  "nome": "Serviço com faixa errada",
  "precoMinimo": 300,
  "precoMaximo": 100,
  "tempoEstimadoMin": 60
}

### Lista os serviços ativos (experimente ?busca=lava ou ?incluirInativos=true)
GET {{baseUrl}}/api/servicos?busca=lava
Authorization: Bearer {{login.response.body.token}}

### Desativa o serviço criado acima
POST {{baseUrl}}/api/servicos/{{servico.response.body.id}}/desativar
Authorization: Bearer {{login.response.body.token}}

# ===== Clientes e veículos (rode o login antes) =====

### Cria um cliente já com o primeiro veículo
# @name cliente
POST {{baseUrl}}/api/clientes
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "nome": "Cliente de Teste",
  "whatsApp": "(11) 99999-8888",
  "veiculos": [{ "placa": "abc-1d23", "modelo": "Civic 2019" }]
}

### Busca por nome (sem acento), placa ou WhatsApp
GET {{baseUrl}}/api/clientes?busca=abc1d
Authorization: Bearer {{login.response.body.token}}

### Adiciona outro veículo ao cliente
POST {{baseUrl}}/api/clientes/{{cliente.response.body.id}}/veiculos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "placa": "XYZ9876", "modelo": "Onix" }

### Exclui o cliente de teste (e os veículos dele)
DELETE {{baseUrl}}/api/clientes/{{cliente.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

# ===== Orçamentos (rode o login e "Cria um cliente" antes) =====

### Cria um orçamento com um item avulso e 10% de desconto
# @name orcamento
POST {{baseUrl}}/api/orcamentos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "clienteId": "{{cliente.response.body.id}}",
  "veiculoId": "{{cliente.response.body.$.veiculos[0].id}}",
  "itens": [{ "descricao": "Lavagem de teste", "quantidade": 1, "valorUnitario": 150, "tempoEstimadoMin": 120 }],
  "descontoTipo": "Percentual",
  "descontoValor": 10
}

### Lista os orçamentos (experimente ?status=Rascunho ou ?busca=ORC-2026-0001)
GET {{baseUrl}}/api/orcamentos
Authorization: Bearer {{login.response.body.token}}

### Aprova o orçamento criado acima
POST {{baseUrl}}/api/orcamentos/{{orcamento.response.body.id}}/aprovar
Authorization: Bearer {{login.response.body.token}}
